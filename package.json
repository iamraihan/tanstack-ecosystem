    "@tanstack/react-router-devtools": "^1.129.8",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-feather": "^2.0.10",
    "tailwindcss": "^4.1.11"
